{
  "name": "@cf/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput > /dev/null 2>&1 &) && node --enable-source-maps --watch dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "db:push": "prisma db push --skip-generate",
    "seed": "tsx prisma/seed.ts",
    "db:sync": "bash scripts-db-sync.sh",
    "compile": "tsc -p tsconfig.build.json",
    "test:prepare": "bash -c 'createdb -h localhost -U postgres conversaforge_test 2>/dev/null; DB=postgresql://postgres:postgres@localhost:5432/conversaforge_test; DATABASE_URL=$DB npx prisma db push --skip-generate --accept-data-loss && psql $DB -q -f prisma/sql/post-push.sql'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@cf/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "^8.3.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/platform-ws": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.58.5",
    "fastify": "^5.6.1",
    "ioredis": "^5.7.0",
    "mammoth": "^1.10.0",
    "nodemailer": "^7.0.6",
    "openai": "^5.23.0",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "^1.3.2",
    "ws": "^8.18.3",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.6",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/ws": "8.18.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "isolatedModules": true
        }
      ]
    },
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/test/global-setup.ts"
  }
}