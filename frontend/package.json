{
  "name": "conversaforge-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "echo 'web unit tests: none (see e2e)'",
    "e2e": "playwright test",
    "check-shared-drift": "bash scripts/check-shared-drift.sh"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "clsx": "2.1.1",
    "next": "15.5.26",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "swr": "2.3.6",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredOptionalDependencies": [
      "sharp"
    ]
  }
}
