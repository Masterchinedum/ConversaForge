# ─── ConversaForge frontend environment template ──────────────────────────────
# Copy to frontend/.env.local. Nothing here is secret: it only says where the backend is.

# Where the Next.js server proxies /api/* (server-side). Resolved at build time for `next build`.
API_INTERNAL_URL=http://localhost:4000
# Where the browser opens the live WebSocket (baked into the client bundle at build time).
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000
