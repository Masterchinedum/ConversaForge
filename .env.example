# ─── ConversaForge environment template ───────────────────────────────────────
# Copy to apps/api/.env (API + worker) and apps/web/.env.local (web). Never commit real secrets.

# Core
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Extra origins allowed to call the API with credentials / embed (comma separated)
CORS_ORIGINS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conversaforge?schema=public
REDIS_URL=redis://localhost:6379
# 32 random bytes, hex or base64:  openssl rand -hex 32
ENCRYPTION_KEY=
# 32+ random chars:  openssl rand -base64 48
SIGNING_SECRET=
COOKIE_SECURE=false
# Proxies whose X-Forwarded-For is trusted (default: loopback + private networks, e.g. Caddy/Next in Docker)
TRUST_PROXY=loopback,linklocal,uniquelocal
SESSION_TTL_DAYS=30
LOG_LEVEL=info
# Run BullMQ workers inside the API process (dev). In production run the worker separately and set false.
RUN_WORKERS_IN_API=true

# Storage: "local" (dev, files on disk) or "r2" (Cloudflare R2 bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Cloudflare R2 (STORAGE_DRIVER=r2). Account ID: R2 overview page. Keys: R2 → Manage API tokens →
# Create API token with "Object Read & Write" on the bucket. Keep the bucket private (no public r2.dev URL):
# media is only served through short-lived signed URLs after an authorization check.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── AI providers (optional; workspace admins can also add keys in Settings → AI providers) ───
# Anthropic Claude — language model for live conversations, analysis, drafting assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_LIVE_MODEL=claude-opus-5
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
# Live conversations default to a speech-to-speech "live" model: Google Gemini Live (GEMINI_LIVE_MODEL),
# with OpenAI (OPENAI_REALTIME_MODEL) as the backup when Gemini has no key or fails during the call
# (scenario Model → live provider "auto"). Browser speech is the last resort: without a working live model,
# sessions fall back to the speech pipeline (browser/server STT → LLM → TTS).
# OpenAI — optional: Realtime voice (speech-to-speech), server TTS/STT, or as the language model.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-4.1-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1
# Backup live (speech-to-speech) model, used when Gemini Live is not configured or fails.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Google Gemini (Gemini Developer API key from aistudio.google.com) — optional: Gemini Live voice
# (speech-to-speech via short-lived ephemeral tokens; the key never reaches the browser) and/or the
# language model for pipeline conversations, scoring/extraction, the drafting assistant and coach memory.
# GOOGLE_API_KEY is accepted as an alias when GEMINI_API_KEY is empty.
GEMINI_API_KEY=
# Default live (speech-to-speech) model for conversations.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Text model for live conversations in pipeline mode (fallback when no live model is used).
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Text model for post-session scoring/extraction, drafting assistant and coach memory.
GEMINI_ANALYSIS_MODEL=gemini-2.5-pro
# Optional: override the Gemini API base URL (proxies / tests). Default https://generativelanguage.googleapis.com
GEMINI_BASE_URL=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# With no provider configured, sessions use the clearly-labeled local simulator. Set false in production.
ALLOW_SIMULATOR=true

# ─── Channels (optional) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RECALL_API_KEY=
RECALL_REGION=us-east-1
# Recall.ai workspace verification secret (whsec_...) for its webhooks (Svix scheme)
RECALL_WEBHOOK_SECRET=

# Developer platform
# Requests per minute per API key on /api/v1
API_KEY_RATE_LIMIT_PER_MIN=600
# Consecutive failed webhook deliveries (retries exhausted) before a subscription is auto-disabled
WEBHOOK_DISABLE_AFTER_FAILURES=5

# ─── Email (optional; without SMTP, emails are written to the API log) ───
SMTP_URL=
MAIL_FROM=ConversaForge <no-reply@example.com>

# ─── Limits ───
DEFAULT_MAX_SESSION_MINUTES=30
PUBLIC_RUN_RATE_LIMIT_PER_HOUR=20

# ── Billing ──
# none (default): no billing, all workspaces on the "free" plan with admin-configured quotas.
# stripe: adapter stub — requires STRIPE_SECRET_KEY (+ STRIPE_WEBHOOK_SECRET); see docs/workstreams/E-access-admin.md.
BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Web (apps/web/.env.local) ───
# Where the Next.js server proxies /api/* (server-side), and where the browser opens the live WebSocket.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000
